NODE_ENV=development
PORT=5000




# --------------jwt access token----------
JWT_ACCESS_SECRET_SIGNATURE=access_secret_token_dont_share_production_its_sensitive
JWT_ACCESS_EXPIRES=1d # 2s, 1w,1m,1y, 2h, evabe dewa jabe.

# --------jwt refresh token-------------
JWT_REFRESH_SECRET = jwt_refresh_secret_signature
JWT_REFRESH_EXPIRES = 30d


# -------------bcryptjs ---------------
BCRYPT_SALT_ROUND=10 # koibar salt kore password hashing kora hocce, eta other kew janle prbm,


